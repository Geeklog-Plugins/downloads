<!-- Downloads 1.4.0 detail -->
{block_header}
<div class="dlm-v14-detail">
  <nav class="dlm-v14-detail-breadcrumb">{category_path_link}</nav>
  <article class="dlm-v14-detail-article">
    <header class="dlm-v14-detail-header">
      <div class="dlm-v14-detail-media"><img src="{thumbnail_url}" alt="" aria-hidden="true">{snaplinkicon}</div>
      <div class="dlm-v14-detail-summary">
        <h1 class="dlm-v14-detail-title">{dtitle} {newdownload}{popdownload}</h1>
        <div class="dlm-v14-detail-category">{lang_category}: {category_path}</div>
        <div class="dlm-v14-detail-facts">
          <span>{lang_version}: {version}</span>
          <span>{lang_size}: {file_size}</span>
          <span>{lang_submitdate}: {datetime}</span>
        </div>
        <div class="dlm-v14-detail-extras">
          <span>{lang_submitter}: {submitter_name}</span>
          <span>{lang_homepage}: {homepage_link}</span>
          <span>{lang_rating}: <a href="{site_url}/downloads/ratefile.php?lid={lid}">{rating}</a>{votestring}</span>
          <span>{lang_popularity}: {begin_dlreport_link}{download_count}{end_dlreport_link}</span>
          <span class="{notags}">{lang_tags}: {tags}</span>
        </div>
      </div>
      <div class="dlm-v14-detail-action"><a href="{visitfile_url}" title="{download_title}" class="dlm-v14-download">{lang_download_button}</a></div>
    </header>
    <div class="dlm-v14-detail-content">
      <div class="dlm-v14-detail-description">{file_description}</div>
      <div class="dlm-v14-detail-notes">{file_detail}</div>
    </div>
    <footer class="dlm-v14-detail-footer">
      <div class="dlm-v14-detail-checksum"><strong>{lang_md5_checksum}:</strong> <code>{md5_checksum}</code></div>
      <nav class="dlm-v14-detail-links">
        <a href="{visitfile_url}">{lang_download}</a>
        <a href="{filedetail_url}">{lang_permalink}</a>
        <a href="{site_url}/downloads/ratefile.php?lid={lid}">{lang_ratethisfile}</a>
        <span style="display:{show_editlink};"><a href="{site_admin_url}/plugins/downloads/index.php?lid={lid}&amp;op=modify&amp;p=item">{lang_edit}</a></span>
      </nav>
    </footer>
  </article>
  {project_filelist}
  {item_extensions}
  <div class="dlm-comments">{comment_records}</div>
</div>
{block_footer}
<!-- end Downloads detail -->

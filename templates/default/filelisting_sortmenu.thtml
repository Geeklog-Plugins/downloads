
<!-- start filelisting_sortmenu.thtml -->
<div class="header-listcontrol">
<div>
  <div class="sortby">
    {lang_sortby}:&nbsp;
    <div class="btn"><a href="{site_url}/downloads/index.php?cid={cid0}&amp;orderby=dated&amp;nppage={nppage}{search_query_suffix}" class="{current_ord_d}">{lang_datenew}</a></div>
    <div class="btn"><a href="{site_url}/downloads/index.php?cid={cid0}&amp;orderby=titlea&amp;nppage={nppage}{search_query_suffix}" class="{current_ord_t}">{lang_titleatoz}</a></div>
    <div class="btn"><a href="{site_url}/downloads/index.php?cid={cid0}&amp;orderby=hitsd&amp;nppage={nppage}{search_query_suffix}" class="{current_ord_h}">{lang_popularitymtol}</a></div>
    <div class="btn"><a href="{site_url}/downloads/index.php?cid={cid0}&amp;orderby=ratingd&amp;nppage={nppage}{search_query_suffix}" class="{current_ord_r}">{lang_ratinghtol}</a></div>
  </div>
  <div class="perpage">
    {lang_numperpage}:&nbsp;
    <div class="btn"><a href="{site_url}/downloads/index.php?cid={cid0}&amp;orderby={orderby}&amp;nppage=5{search_query_suffix}" class="{current_num_5}">5</a></div>
    <div class="btn"><a href="{site_url}/downloads/index.php?cid={cid0}&amp;orderby={orderby}&amp;nppage=10{search_query_suffix}" class="{current_num_10}">10</a></div>
    <div class="btn"><a href="{site_url}/downloads/index.php?cid={cid0}&amp;orderby={orderby}&amp;nppage=20{search_query_suffix}" class="{current_num_20}">20</a></div>
    <div class="btn"><a href="{site_url}/downloads/index.php?cid={cid0}&amp;orderby={orderby}&amp;nppage=50{search_query_suffix}" class="{current_num_50}">50</a></div>
  </div>
</div>
</div>
<!-- end filelisting_sortmenu.thtml -->

<!-- Downloads public catalog card -->
<article class="dlm-v14-card">
  <div class="dlm-v14-media dlm-v14-media-empty"><img src="{thumbnail_url}" alt="" aria-hidden="true">{snaplinkicon}</div>
  <div class="dlm-v14-content">
    <h3 class="dlm-v14-title"><a href="{filedetail_url}" title="{dtitle}">{dtitle}</a> {newdownload}{popdownload}</h3>
    <div class="dlm-v14-category">{lang_category}: {category_path}</div>
    <div class="dlm-v14-facts">
      <span>{lang_version}: {version}</span><span>{lang_size}: {file_size}</span><span>{lang_submitdate}: {datetime}</span>
    </div>
    <div class="dlm-v14-description">{file_description}</div>
    <nav class="dlm-v14-links" aria-label="Download actions">
      <a href="{filedetail_url}">{lang_filelink}</a>
      <span style="display:{show_comments};">{comment_link}</span>
      <a href="{site_url}/downloads/ratefile.php?lid={lid}">{lang_ratethisfile}</a>
      <span style="display:{show_editlink};"><a href="{site_admin_url}/plugins/downloads/index.php?lid={lid}&amp;op=modify&amp;p=flist&amp;cid={listing_cid}">{lang_edit}</a></span>
    </nav>
  </div>
  <aside class="dlm-v14-action"><a href="{visitfile_url}" title="{download_title}" class="dlm-v14-download">{lang_download_button}</a><div class="dlm-v14-popularity">{lang_popularity}: {begin_dlreport_link}{download_count}{end_dlreport_link}</div></aside>
</article>
